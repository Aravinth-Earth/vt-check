#!/usr/bin/env python3
"""vt-check — terminal entry point. Symlink this into ~/.local/bin:

    ln -sf "$(pwd)/bin/vt-check" ~/.local/bin/vt-check
"""

import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
sys.path.insert(0, str(BIN.parent / "plugin"))

# So the CLI can pull VT_API_KEY from the Hermes profile (.env) through Hermes's own loader,
# without this repo ever parsing .env itself. Harmless when Hermes is not installed.
_hermes = Path.home() / ".hermes" / "hermes-agent"
if _hermes.is_dir():
    sys.path.append(str(_hermes))

from vt_check_cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
